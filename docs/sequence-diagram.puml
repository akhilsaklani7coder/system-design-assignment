@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true
actor Customer as customer
participant BookingService as bookingService
participant Show as show
participant ShowSeat as showSeat
participant PriceCalculator as priceCalculator
participant Payment as payment
participant Booking as booking
participant TicketPrinter as ticketPrinter
customer -> payment : <<create>> UpiPayment(upiId)
activate payment
customer -> bookingService : book(customer, show, [A1], payment)
activate bookingService
bookingService -> show : findSeat("A1")
activate show
show --> bookingService : ShowSeat reference
deactivate show
bookingService -> showSeat : isAvailable()
showSeat --> bookingService : true
bookingService -> priceCalculator : calculate([A1])
activate priceCalculator
priceCalculator --> bookingService : ₹150
deactivate priceCalculator
bookingService -> showSeat : bookSeat()
showSeat --> bookingService : true
create booking
bookingService -> booking : <<create>> Booking(customer, show, [A1], ₹150)
activate booking
booking --> bookingService : booking reference
deactivate booking
bookingService -> payment : pay(₹150)
payment --> bookingService : true
deactivate payment
bookingService -> booking : confirm()
booking --> bookingService : confirmed
bookingService -> ticketPrinter : print(booking)
activate ticketPrinter
ticketPrinter --> bookingService : ticket printed
deactivate ticketPrinter
bookingService --> customer : confirmed booking + ticket
deactivate bookingService
@enduml
